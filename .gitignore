# ===================================================
# Mineral Springs Retreat - Production .gitignore
# ===================================================

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.local
.env.*.local
*.env
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs & caches
dist/
build/
.vite/
.cache/

# Server runtime data & local databases (NEVER commit runtime data!)
server/data/db.json
server/data/*.tmp*
server/data/backups/*
!server/data/backups/.gitkeep
!server/data/db.example.json
*.tmp
*.db
*.sqlite
*.sqlite3

# Uploaded user media (preserve directory via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# Temporary testing & scratch scripts
scratch/
test_*.mjs
capture_*.mjs
*.test.mjs

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

.vercel
.env*
