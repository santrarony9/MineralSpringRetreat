# =================================================================
# Mineral Springs Retreat - Environment Variables Template
# Copy this file to .env and configure your production credentials.
# NEVER commit the actual .env file to public repositories!
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5000

# Session Secret (Replace with a strong random string in production)
SESSION_SECRET=your-random-32-character-session-secret-key-here

# Google OAuth 2.0 Credentials (for Guest Login & Reservation Auth)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# Meta WhatsApp Business Cloud API Configuration
# Host automatically receives WhatsApp alerts when guests book, cancel, or modify
# Obtain from Meta for Developers: https://developers.facebook.com/apps/
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_HOST_PHONE=+919832012345
WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-whatsapp-business-account-id
WHATSAPP_API_VERSION=v21.0

# Persistent Cloud Storage Configuration (Required for Vercel Serverless)
# Option 1: Vercel KV / Upstash Redis (Recommended - zero setup in Vercel Storage tab)
KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=your-upstash-redis-token

# Option 2: Cloud Image Storage (Optional - base64 storage in KV used by default)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
